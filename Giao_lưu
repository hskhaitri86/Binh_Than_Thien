    <!-- Scripts -->
    <script>
        // Mobile Navigation Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Interactive Accordion Chapters
        const chapterBtns = document.querySelectorAll('.chapter-btn');
        document.getElementById('chap1').classList.remove('hidden');
        document.querySelector('[data-target="chap1"] .chapter-icon').classList.add('rotate-180');

        chapterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                const content = document.getElementById(targetId);
                const icon = btn.querySelector('.chapter-icon');

                if (content.classList.contains('hidden')) {
                    content.classList.remove('hidden');
                    icon.classList.add('rotate-180');
                } else {
                    content.classList.add('hidden');
                    icon.classList.remove('rotate-180');
                }
            });
        });

        // Image Uploader & LocalStorage Persistence
        const imageUploadInput = document.getElementById('imageUploadInput');
        const headerAvatar = document.getElementById('headerAvatar');
        const mainHeroImage = document.getElementById('mainHeroImage');
        const bodyBg = document.getElementById('bodyBg');

        // Check stored image if exists
        const savedImage = localStorage.getItem('peace_nguyen_bg_avatar');
        if (savedImage) {
            headerAvatar.src = savedImage;
            mainHeroImage.src = savedImage;
            bodyBg.style.backgroundImage = `url('${savedImage}')`;
        }

        imageUploadInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const base64Url = event.target.result;
                    headerAvatar.src = base64Url;
                    mainHeroImage.src = base64Url;
                    bodyBg.style.backgroundImage = `url('${base64Url}')`;
                    try {
                        localStorage.setItem('peace_nguyen_bg_avatar', base64Url);
                    } catch(err) {
                        console.log('Storage limit exceeded or unavailable');
                    }
                };
                reader.readAsDataURL(file);
            }
        });

        // Guestbook & Dynamic Testimonial Addition
        const messageForm = document.getElementById('messageForm');
        const statusAlert = document.getElementById('statusAlert');
        const testimonialsGrid = document.getElementById('testimonialsGrid');

        messageForm.addEventListener('submit', (e) => {
            e.preventDefault();

            const name = document.getElementById('senderName').value.trim();
            const contact = document.getElementById('senderContact').value.trim();
            const message = document.getElementById('senderMessage').value.trim();

            if (name && message) {
                const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) || 'DG';

                const card = document.createElement('div');
                card.className = "testimonial-card glass-card p-8 rounded-3xl relative flex flex-col justify-between border-2 border-gold-warm/60 transform transition-all duration-500";
                card.innerHTML = `
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex text-gold-warm text-xs space-x-1">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                            </div>
                            <span class="text-[10px] bg-gold-warm text-navy-950 font-bold px-2 py-0.5 rounded-full uppercase">Mới</span>
                        </div>
                        <p class="text-gray-200 font-serif text-sm leading-relaxed italic">
                            "${sanitizeHtml(message)}"
                        </p>
                    </div>
                    <div class="pt-6 mt-6 border-t border-gold-warm/20 flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-full bg-gold-warm text-navy-950 font-bold flex items-center justify-center font-serif text-base shrink-0">
                            ${sanitizeHtml(initials)}
                        </div>
                        <div>
                            <h4 class="font-bold text-gold-champagne text-sm">${sanitizeHtml(name)}</h4>
                            <span class="text-[11px] text-gray-400 block font-light">${sanitizeHtml(contact || 'Độc giả')}</span>
                        </div>
                    </div>
                `;

                testimonialsGrid.prepend(card);

                statusAlert.classList.remove('hidden');
                messageForm.reset();

                card.scrollIntoView({ behavior: 'smooth', block: 'center' });

                setTimeout(() => {
                    statusAlert.classList.add('hidden');
                }, 5000);
            }
        });

        function sanitizeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }
    </script>

